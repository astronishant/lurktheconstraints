# ── Firebase (free Spark plan: Firestore + Google Auth) ──────────────────────
# The app is hosted on Vercel (free Hobby tier). Firebase is used only for the
# database and Google sign-in, so no Blaze plan or credit card is required.
#
# Server-side (Firestore) — Firebase Console → Project settings → Service accounts
# → Generate new private key → copy the values from the downloaded JSON.
# Paste the private key exactly as-is (with literal \n for newlines).

FIREBASE_PROJECT_ID=lurktheconstraints
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lurktheconstraints.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"

# ── Browser (public identifiers, not secrets) ────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app.
# authDomain stays on the Firebase project domain so the Google OAuth popup can
# redirect back to any host. Add your Vercel domain under
# Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lurktheconstraints.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lurktheconstraints
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# ── Optional: Live LLM backend ──────────────────────────────────────────────
# Add ONE of these to activate real LLM evaluation (pattern-matching used otherwise)
# Also run: npm install @anthropic-ai/sdk   OR   npm install openai

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: restrict the signed-in scoring window (defaults: always open).
# COHORT_STARTS_AT=2000-01-01T00:00:00Z
# COHORT_ENDS_AT=2099-12-31T23:59:59Z
