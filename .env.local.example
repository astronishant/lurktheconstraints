# ── Firebase (Firestore persistence) ──────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → copy values from the downloaded JSON

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key exactly as-is (with literal \n for newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"

# ── Optional: Live LLM backend ─────────────────────────────────────────────────
# Add ONE of these to activate real LLM evaluation (pattern-matching used otherwise)
# Also run: npm install @anthropic-ai/sdk   OR   npm install openai

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Lurk the Constraints client config from Firebase Console → Project settings → Your apps.
# These are public Firebase web app identifiers, not service-account secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lurktheconstraints.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lurktheconstraints
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Optional: restrict the signed-in scoring window (defaults: always open).
# COHORT_STARTS_AT=2000-01-01T00:00:00Z
# COHORT_ENDS_AT=2099-12-31T23:59:59Z
